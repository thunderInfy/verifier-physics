{
  "name": "simple pendulum, length dropped",
  "true": false,
  "expect": "REFUTED",
  "why": "th'' = -g sin th has the wrong dimension and fails wherever l != 1",
  "coordinates": [
    "th"
  ],
  "symbols": {
    "th": {
      "dim": "1"
    },
    "m": {
      "dim": "M"
    },
    "l": {
      "dim": "L"
    },
    "g": {
      "dim": "L T^-2"
    }
  },
  "lagrangian": "m*l^2*th_dot^2/2 + m*g*l*cos(th)",
  "domain": [
    "m > 0",
    "l > 0",
    "g > 0"
  ],
  "eom": [
    {
      "lhs": "th_ddot",
      "rhs": "-g*sin(th)"
    }
  ]
}
