{
  "name": "two coupled oscillators, force form, listed in reverse",
  "true": true,
  "expect": "VERIFIED",
  "why": "the equations times the masses, x2 first: anti-diagonal certificate matrix",
  "coordinates": [
    "x1",
    "x2"
  ],
  "symbols": {
    "x1": {
      "dim": "L"
    },
    "x2": {
      "dim": "L"
    },
    "m1": {
      "dim": "M"
    },
    "m2": {
      "dim": "M"
    },
    "k1": {
      "dim": "M T^-2"
    },
    "k2": {
      "dim": "M T^-2"
    },
    "kc": {
      "dim": "M T^-2"
    }
  },
  "lagrangian": "m1/2*x1_dot^2 + m2/2*x2_dot^2 - k1/2*x1^2 - k2/2*x2^2 - kc/2*(x1 - x2)^2",
  "domain": [
    "m1 > 0",
    "m2 > 0"
  ],
  "eom": [
    {
      "lhs": "m2*x2_ddot + (k2 + kc)*x2",
      "rhs": "kc*x1"
    },
    {
      "lhs": "m1*x1_ddot + (k1 + kc)*x1",
      "rhs": "kc*x2"
    }
  ]
}
