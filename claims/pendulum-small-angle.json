{
  "name": "simple pendulum, small-angle law claimed for all angles",
  "true": false,
  "expect": "REFUTED",
  "why": "sin th < th for th > 0, so th'' = -(g/l) th fails at th = 1/2",
  "coordinates": [
    "th"
  ],
  "symbols": {
    "th": {
      "dim": "1"
    },
    "m": {
      "dim": "M"
    },
    "l": {
      "dim": "L"
    },
    "g": {
      "dim": "L T^-2"
    }
  },
  "lagrangian": "m*l^2*th_dot^2/2 + m*g*l*cos(th)",
  "domain": [
    "m > 0",
    "l > 0",
    "g > 0"
  ],
  "eom": [
    {
      "lhs": "th_ddot",
      "rhs": "-(g/l)*th"
    }
  ]
}
