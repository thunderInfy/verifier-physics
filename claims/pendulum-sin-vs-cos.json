{
  "name": "simple pendulum, cos instead of sin",
  "true": false,
  "expect": "REFUTED",
  "why": "at th = 0 the claim gives th'' = -g/l, the EL equation th'' = 0",
  "coordinates": [
    "th"
  ],
  "symbols": {
    "th": {
      "dim": "1"
    },
    "m": {
      "dim": "M"
    },
    "l": {
      "dim": "L"
    },
    "g": {
      "dim": "L T^-2"
    }
  },
  "lagrangian": "m*l^2*th_dot^2/2 + m*g*l*cos(th)",
  "domain": [
    "m > 0",
    "l > 0",
    "g > 0"
  ],
  "eom": [
    {
      "lhs": "th_ddot",
      "rhs": "-(g/l)*cos(th)"
    }
  ]
}
