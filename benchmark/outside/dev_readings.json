  {
   "id": "zhang_shu_2010_maxprinciple:02",
   "readings": [
    {
     "field": "with_hypotheses",
     "reading": "the two-stage SSP Runge-Kutta method (SSP coefficient 1) of the first-order Lax-Friedrichs step for u_t + u_x = 0 keeps every cell average in [m, M] for every nu = dt/dx in [0, 1], the CFL bound of the Euler step times the SSP coefficient",
     "narrowing": "f(u) = u (so h(u, v) = u, upwind); degree-0 polynomials (the limiter does nothing); the two-stage SSP Runge-Kutta method instead of the source's three-stage (2.12), because three stages of a two-point scheme need u_{i-3}, outside the five-point stencil",
     "instance_from_justification": false,
     "formalization": [
      {
       "spec": "ssp-rk2-upwind-advection.json",
       "claim": "positive_under_cfl",
       "relation": "same",
       "bridge": "for a linear update u_i^{n+1} = sum_k c_k u_{i+k} with sum_k c_k = 1, 'u^n in [m, M] for all j implies u^{n+1} in [m, M]' for every data and every m <= M holds iff every c_k >= 0 (if c_k < 0, put m where c_k < 0 and M elsewhere)"
      }
     ],
     "actual": {
      "verdict": "VERIFIED",
      "components": [
       {
        "named": "VERIFIED",
        "reading": "VERIFIED"
       }
      ]
     }
    },
    {
     "field": "alone",
     "reading": "the same method keeps the maximum principle with no time step restriction; necessary for it: for every nu in [0, 2]",
     "narrowing": "as for the with-hypotheses reading; the Courant range [0, 2] stands for 'no restriction'",
     "instance_from_justification": true,
     "formalization": [
      {
       "spec": "ssp-rk2-upwind-advection.json",
       "override": {
        "claims": {
         "positive_cfl": [
          "0",
          "2"
         ]
        }
       },
       "claim": "positive_under_cfl",
       "relation": "necessary",
       "bridge": "as above; the unrestricted claim implies the claim on [0, 2]"
      }
     ],
     "actual": {
      "verdict": "REFUTED",
      "components": [
       {
        "named": "REFUTED",
        "reading": "REFUTED"
       }
      ]
     }
    }
   ],
