{
  "kind": "variational",
  "name": "free particle in 2D",
  "coordinates": ["x", "y"],
  "symbols": {"x": {"dim": "L"}, "y": {"dim": "L"}, "h": {"dim": "T"}, "m": {"dim": "M"}},
  "discrete_lagrangian": "h*m/2*(((x_1 - x_0)/h)^2 + ((y_1 - y_0)/h)^2)",
  "lagrangian": "m/2*(x_dot^2 + y_dot^2)",
  "domain": ["m > 0"],
  "claims": [
    {
      "claim": "discrete_momentum_conserved",
      "quantity": "m*(x_0*y_1 - x_1*y_0)/h",
      "true": true,
      "expect": "VERIFIED",
      "why": "L_d is invariant under rotations, xi(q) = (-y, x); J_d = D2 L_d(q0, q1).xi(q1)"
    },
    {
      "claim": "discrete_momentum_conserved",
      "quantity": "m*(x_1 - x_0)/h",
      "true": true,
      "expect": "VERIFIED",
      "why": "L_d is invariant under translations in x, xi = (1, 0)"
    },
    {
      "claim": "consistent_order_p",
      "p": 2,
      "true": true,
      "expect": "VERIFIED",
      "why": "the DEL is the centred second difference"
    }
  ]
}
